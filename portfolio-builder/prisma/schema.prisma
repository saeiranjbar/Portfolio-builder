// Prisma schema for Portfolio Builder application
// Using SQLite for development; can be switched to PostgreSQL/MySQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication (NextAuth)
model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  // Relations
  accounts      Account[]
  sessions      Session[]
  portfolios    Portfolio[]
  projects      Project[]
  sites         Site[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id          String   @id @default(uuid())
  title       String
  description String?
  data        String   // Stores the portfolio JSON structure as string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
}

// --- Site models (multi-page website builder; see docs/site-data-model.md) ---
// Portfolio/Project above are legacy and will be migrated into Site, then retired.

model Site {
  id           String    @id @default(uuid())
  userId       String
  name         String
  slug         String    @unique // subdomain or path identity for the published site
  customDomain String?   @unique
  status       String    @default("draft") // draft | published
  settings     String // JSON: SiteSettings (theme, navbar, footer, dark mode)
  seo          String // JSON: SiteSeo (site-wide defaults)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages     Page[]
  revisions SiteRevision[]
  aiBrief   AiBrief?
}

model Page {
  id        String   @id @default(uuid())
  siteId    String
  slug      String // "" = home, "about", "services/web-design"
  title     String
  order     Int      @default(0)
  seo       String? // JSON: PageSeo (falls back to site seo)
  sections  String // JSON: Section[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
}

model SiteRevision {
  id        String   @id @default(uuid())
  siteId    String
  source    String // manual | ai | template | autosave
  data      String // JSON: full snapshot { settings, seo, pages }
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model AiBrief {
  id         String   @id @default(uuid())
  siteId     String   @unique
  rawAnswers String // JSON: full Q&A transcript from AI-guided mode
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

// Project model for individual portfolio projects
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String?  // Rich text or markdown content
  thumbnail   String?  // URL to thumbnail image
  liveUrl     String?  // URL to live demo
  repoUrl     String?  // URL to source code repository
  technologies String? // Comma-separated list of technologies used
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  portfolioId String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
}
